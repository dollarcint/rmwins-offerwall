# Copy this file to /home/www.rmwinsights.com/.config/rmwins-offerwall/backend.env,
# replace every "replace-with-..." value. Never commit the
# populated file. The deploy wrapper stores it as root:wwwrm1759 mode 0640.
# Keep the three encryption keys stable for the lifetime of the data they protect.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
RESPONDENT_EMAIL_ENCRYPTION_KEY=replace-with-another-stable-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=offerwall.rmwinsights.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://offerwall.rmwinsights.com
DJANGO_CORS_ALLOWED_ORIGINS=https://offerwall.rmwinsights.com
DJANGO_BEHIND_HTTPS_PROXY=true
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=0
TRUST_X_FORWARDED_FOR=true
TRUST_CLOUDFLARE_HEADERS=false

# JSON login protection. Keep the application limiter enabled even though the
# public Nginx vhost also rate-limits this endpoint.
AUTH_LOGIN_MAX_BODY_BYTES=16384
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_MAX_IP_ATTEMPTS=30
AUTH_LOGIN_WINDOW_SECONDS=300
# Set redirect=true and HSTS=31536000 only after the offerwall hostname has a
# valid certificate and has passed external checks.
PUBLIC_APP_BASE_URL=https://offerwall.rmwinsights.com
PUBLIC_RESULT_BASE_URL=https://offerwall.rmwinsights.com
OFFERWALL_ENABLED=true
OFFERWALL_PUBLIC_BASE_URL=https://offerwall.rmwinsights.com
OFFERWALL_ENTRY_TTL_SECONDS=900
OFFERWALL_VISIT_TTL_SECONDS=7200
OFFERWALL_POSTBACK_TIMEOUT_SECONDS=10
OFFERWALL_POSTBACK_MAX_ATTEMPTS=6
OFFERWALL_POSTBACK_SOURCE_IP=82.29.166.173
OFFERWALL_PORTAL_LINK_TTL_SECONDS=900
OFFERWALL_PORTAL_SESSION_TTL_SECONDS=43200
OFFERWALL_MINIMUM_PAYOUT=50.00
OFFERWALL_VERIFICATION_TTL_SECONDS=900
OFFERWALL_VERIFICATION_RESEND_SECONDS=60
OFFERWALL_VERIFICATION_MAX_ATTEMPTS=5
OFFERWALL_RESPONDENT_STATE_TTL_SECONDS=7200
CINT_CALLBACK_BASE_URL=https://offerwall.rmwinsights.com

# Respondent verification email. The CyberPanel host can use its local mail
# transfer agent on 127.0.0.1:25, or replace these values with an SMTP provider.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=127.0.0.1
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@rmwinsights.com

# Documentation requires both an authorized Django session and these Basic
# Auth credentials. Generate a unique password.
API_DOCS_BASIC_USERNAME=offerwall-docs
API_DOCS_BASIC_PASSWORD=replace-with-a-long-random-password

# Main operational database on the server PostgreSQL 16 service. The deploy
# script creates only this dedicated database/user; it never reuses postgres.
DB_ENGINE=postgresql
DB_NAME=rmwins_offerwall_prod
DB_USER=rmwins_offerwall_app
DB_PASSWORD=replace-with-a-long-random-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=true
DB_CONNECT_TIMEOUT=10

# The response vault must use a different database and user.
PRESCREENER_VAULT_ENABLED=true
PRESCREENER_DB_ENGINE=postgresql
PRESCREENER_DB_NAME=rmwins_offerwall_vault
PRESCREENER_DB_USER=rmwins_offerwall_vault_app
PRESCREENER_DB_PASSWORD=replace-with-a-different-random-database-password
PRESCREENER_DB_HOST=127.0.0.1
PRESCREENER_DB_PORT=5432
PRESCREENER_DB_CONN_MAX_AGE=60
PRESCREENER_DB_CONN_HEALTH_CHECKS=true
PRESCREENER_DB_CONNECT_TIMEOUT=10

# Provider credentials are optional unless that provider is enabled. Retain
# the real values from the protected production environment when redeploying.
INNOVATEMR_API_TOKEN=
INNOVATEMR_BASE_URL=https://supplier.innovatemr.net/api/v2
INNOVATEMR_CALLBACK_HASH_SECRET=
INNOVATEMR_CALLBACK_PUBLIC_URL=https://offerwall.rmwinsights.com/imr_callback
PUBLIC_SUPPLIER_CODE=replace-with-assigned-supplier-code
RFG_APID=
RFG_SECRET=
CINT_API_KEY=
CINT_HASH_KEY=
ENLIGNE_DB_PASSWORD=
BIOBRAIN_API_KEY=

INNOVATEMR_TIMEOUT_SECONDS=30
INNOVATEMR_PAGE_SIZE=100
INNOVATEMR_MAX_PAGES=1000
INNOVATEMR_DETAIL_REFRESH_BATCH=20
INNOVATEMR_INVENTORY_SYNC_INTERVAL_SECONDS=150
CLIENT_INTEGRATION_DISPATCH_INTERVAL_SECONDS=30
CLIENT_INTEGRATION_INNOVATEMR_SYNC_INTERVAL_SECONDS=150
CLIENT_INTEGRATION_RFG_SYNC_INTERVAL_SECONDS=60
CLIENT_INTEGRATION_CINT_SYNC_INTERVAL_SECONDS=60
INNOVATEMR_DETAIL_SYNC_INTERVAL_SECONDS=150
INNOVATEMR_ATTEMPT_RECONCILE_INTERVAL_SECONDS=60
INNOVATEMR_ATTEMPT_RECONCILE_BATCH=20
INNOVATEMR_ATTEMPT_RECONCILE_LOOKBACK_HOURS=168

CINT_EMAIL_IDENTITY_CACHE_TTL_SECONDS=3600
CINT_OPPORTUNITIES_WEBHOOK_ENABLED=false
CINT_OPPORTUNITIES_SUPPLIER_CODE=
CINT_OPPORTUNITIES_PUBLIC_KEY=
CINT_OPPORTUNITIES_KEY_ID=
CINT_OPPORTUNITIES_LOCAL_TEST_TOKEN=
CINT_OPPORTUNITIES_SIGNATURE_TOLERANCE_SECONDS=300
CINT_OPPORTUNITIES_MAX_PAYLOAD_BYTES=10485760
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=10551296
CINT_OPPORTUNITIES_MAX_SURVEY_COUNT=1000
CINT_OPPORTUNITIES_PROCESS_SYNCHRONOUS=false
CINT_OPPORTUNITIES_QUEUE_REDIRECTS=true
CINT_OPPORTUNITIES_RETAIN_PROCESSED_PAYLOADS=true
CINT_PROJECT_CACHE_INVALIDATION_SECONDS=30

ENFORCE_SURVEY_TARGET_COUNTRY=true
GEOIP_CITY_DB_PATH=
GEOIP_LOOKUP_URL=
GEOIP_LOOKUP_TIMEOUT_SECONDS=2.5
GEOIP_CACHE_TTL_SECONDS=2592000

# Generate separate URL-safe random passwords for both Redis instances. Copy
# the same values into the protected 0600 Redis configs. Port 6384 persists
# Celery broker/result state; port 6385 is an intentionally non-persistent,
# low-latency cache instance.
CELERY_BROKER_URL=redis://:replace-with-persistent-redis-password@127.0.0.1:6384/0
CELERY_RESULT_BACKEND=redis://:replace-with-persistent-redis-password@127.0.0.1:6384/1
CELERY_RESULT_EXPIRES=3600
# Keep false while the original Alessar deployment is still active or provider
# credentials are unset; enable exactly one Beat/sync scheduler after cutover.
ENABLE_SCHEDULED_JOBS=false
CACHE_ENABLED=true
REDIS_CACHE_URL=redis://:replace-with-cache-redis-password@127.0.0.1:6385/0
PROJECTS_REDIS_CACHE_URL=redis://:replace-with-cache-redis-password@127.0.0.1:6385/1
CACHE_KEY_PREFIX=rmwins_offerwall
CACHE_DEFAULT_TTL_SECONDS=900
CACHE_TTL_JITTER_SECONDS=180
CACHE_CONNECT_TIMEOUT_SECONDS=1
CACHE_SOCKET_TIMEOUT_SECONDS=1
CACHE_MAX_CONNECTIONS=100
VAULT_CACHE_OPTIONS_TTL_SECONDS=600
VAULT_CACHE_SUMMARY_TTL_SECONDS=180
VAULT_CACHE_PROFILE_TTL_SECONDS=900
PROJECT_CACHE_DEFAULT_TTL_SECONDS=300
PROJECT_CACHE_TTL_JITTER_SECONDS=60
PROJECT_CACHE_FILTERS_TTL_SECONDS=600
PROJECT_CACHE_COUNT_TTL_SECONDS=90

VENDOR_RESERVATION_TTL_MINUTES=180
VENDOR_RESERVATION_CLEANUP_INTERVAL_SECONDS=60
